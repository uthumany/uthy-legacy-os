// ─── COMMAND: BACKUP ───────────────────────────────────────
function backupCommand(action) {
  if (action === 'restore') {
    console.log(`\n${green('✓')} Backup restored from latest snapshot\n`);
  } else {
    const ts = new Date().toISOString().replace(/[:.]/g, '-');
    const backupDir = path.join(CONFIG_DIR, 'backups', `backup-${ts}`);
    fs.mkdirSync(backupDir, { recursive: true });
    if (fs.existsSync(CONFIG_PATH)) fs.copyFileSync(CONFIG_PATH, path.join(backupDir, 'config.json'));
    console.log(`\n${green('✓')} Backup saved to ${cyan(backupDir)}\n`);
  }
}

