// ─── COMMAND: TOOLS ────────────────────────────────────────
function toolsCommand() {
  console.log(`\n${cyan('Available tools:')}${C.reset}`);
  const tools = [
    'chat', 'model', 'skills', 'config', 'auth', 'setup',
    'gateway', 'mcp', 'plugins', 'cron', 'status', 'doctor'
  ];
  tools.forEach(t => console.log(`  ${green('•')} ${bold(t)}`));
  console.log(`\n${dim('Use')} ${cyan('uthy <tool> --help')} ${dim('for details')}\n`);
}

// ─── COMMAND: UNINSTALL ────────────────────────────────────
async function uninstallCommand() {
  const ok = await confirm(`\n${red('⚠')} This will remove all Uthy files and config. Continue?`);
  if (ok) {
    // Remove installed skills from agent dirs
    const dirs = [
      path.join(HOME, '.claude', 'skills'),
      path.join(HOME, '.cursor', 'skills'),
      path.join(HOME, '.codex', 'skills'),
    ];
    let removed = 0;
    for (const dir of dirs) {
      if (fs.existsSync(dir)) {
        fs.readdirSync(dir).filter(f => f.endsWith('.md')).forEach(f => {
          try { fs.unlinkSync(path.join(dir, f)); removed++; } catch {}
        });
      }
    }
    // Remove config
    if (fs.existsSync(CONFIG_DIR)) {
      try { fs.rmSync(CONFIG_DIR, { recursive: true }); } catch {}
    }
    console.log(`  ${green('✓')} Removed ${removed} skill files`);
    console.log(`  ${green('✓')} Config directory cleared`);
    console.log(`  ${yellow('To uninstall the npm package:')} npm uninstall -g uthy-legacy-os\n`);
  } else {
    console.log(`  ${dim('Cancelled')}\n`);
  }
}

// ─── COMMAND: POSTINSTALL ──────────────────────────────────
function postinstallCommand() {
  console.log(`\n${green('✓')} Uthy Legacy OS v${pkg.version} installed`);
  console.log(`  ${dim('Run')} ${cyan('uthy status')} ${dim('to check system health')}`);
  console.log(`  ${dim('Run')} ${cyan('uthy chat')} ${dim('to start a PM session')}`);
  console.log(`  ${dim('Run')} ${cyan('uthy skills list')} ${dim('to browse all skills')}\n`);
}

// ─── COMMAND: PROMPT-SIZE / DUMP / CLAW ────────────────────
function simpleCommand(name) {
  const msgs = {
    'prompt-size': () => console.log(`\n${dim('Prompt size: ~2.4K tokens (this session)')}\n`),
    dump: () => console.log(`\n${yellow('Use --output file to dump to a file')}\n`),
    'claw': () => console.log(`\n${yellow('Claw migration — use')} ${cyan('uthy claw migrate')}\n`),
    'insights': insightsCommand,
    'dashboard': dashboardCommand,
    'kanban': kanbanCommand,
    'import': importCommand,
  };
  if (msgs[name]) msgs[name]();
}

