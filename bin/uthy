// ─── PROFILE ───────────────────────────────────────────────
function profileCommand(action, ...args) {
  const profilesDir = path.join(CONFIG_DIR, 'profiles');
  fs.mkdirSync(profilesDir, { recursive: true });
  
  const actions = {
    list: () => {
      const profiles = fs.readdirSync(profilesDir).filter(f => f.endsWith('.json'));
      console.log(`\n${cyan('Profiles:')}${C.reset}`);
      if (profiles.length === 0) console.log(`  ${dim('default (current)')}`);
      else profiles.forEach(p => console.log(`  ${cyan('•')} ${p.replace('.json','')}`));
      console.log();
    },
    show: () => {
      const config = loadConfig();
      console.log(`\n${cyan('Current Profile:')}${C.reset}`);
      console.log(JSON.stringify(config, null, 2));
      console.log();
    },
    create: async () => {
      const name = args[0] || await ask(`${cyan('?')} Profile name: `);
      if (name) {
        fs.writeFileSync(path.join(profilesDir, name + '.json'), JSON.stringify(loadConfig(), null, 2));
        console.log(`\n${green('✓')} Profile '${name}' created\n`);
      }
    },
    delete: () => {
      const name = args[0];
      if (name && fs.existsSync(path.join(profilesDir, name + '.json'))) {
        fs.unlinkSync(path.join(profilesDir, name + '.json'));
        console.log(`\n${green('✓')} Profile '${name}' deleted\n`);
      } else {
        console.log(`\n${red('Profile not found:')} ${name}\n`);
      }
    },
    use: () => {
      const name = args[0];
      if (name && fs.existsSync(path.join(profilesDir, name + '.json'))) {
        const profile = JSON.parse(fs.readFileSync(path.join(profilesDir, name + '.json')));
        saveConfig(profile);
        console.log(`\n${green('✓')} Switched to profile '${name}'\n`);
      } else {
        console.log(`\n${red('Profile not found:')} ${name}\n`);
      }
    },
  };
  
  if (actions[action]) actions[action]();
  else console.log(`\n${bold('Usage:')} uthy profile {list|use|create|delete|show|alias|rename|export|import|install|update|info}\n`);
}

