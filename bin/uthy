// ─── COMMAND: SLACK ────────────────────────────────────────
function slackCommand(action) {
  if (action === 'manifest') {
    console.log(`\n${cyan('Slack Manifest:')}${C.reset}`);
    console.log(`  ${dim('Use --write to save manifest file')}`);
    console.log(`  ${dim('Use --slashes-only for slash commands only')}\n`);
  } else {
    console.log(`\n${bold('Usage:')} uthy slack manifest [--write] [--slashes-only]\n`);
  }
}

