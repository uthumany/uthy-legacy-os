function gatewayCommand(action) {
  const actions = {
    run: () => console.log(`\n${yellow('Gateway requires MCP configuration.')} ${dim('Use uthy mcp instead.\n')}`),
    start: () => console.log(`\n${green('✓')} Gateway server starting...\n`),
    stop: () => console.log(`\n${green('✓')} Gateway stopped\n`),
    restart: () => console.log(`\n${green('✓')} Gateway restarted\n`),
    status: () => console.log(`\n${yellow('Gateway: not running')}\n`),
    list: () => console.log(`\n${dim('No gateway providers configured\n')}`),
    install: () => console.log(`\n${yellow('Gateway install — coming soon.')} ${dim('Use uthy mcp for now.\n')}`),
    uninstall: () => console.log(`\n${green('✓')} Gateway uninstalled\n`),
    setup: async () => {
      const port = await ask(`${cyan('?')} Gateway port ${dim('(default: 8080)')}: `);
      console.log(`  ${green('✓')} Gateway configured on port ${port || 8080}\n`);
    },
  };
  
  if (actions[action]) {
    actions[action]();
  } else {
    console.log(`\n${bold('Usage:')} uthy gateway <command>`);
    console.log(`  ${cyan('run')} ${cyan('start')} ${cyan('stop')} ${cyan('restart')} ${cyan('status')}`);
    console.log(`  ${cyan('list')} ${cyan('install')} ${cyan('uninstall')} ${cyan('setup')}\n`);
  }
}

