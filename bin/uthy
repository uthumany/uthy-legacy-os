#!/usr/bin/env node
/**
 * Uthy — Product Management CLI
 * 
 * Usage: uthy <command> [options]
 * 
 * A full-featured CLI for AI-powered product management.
 * Manages PM skills, chat sessions, models, config, and more.
 */

const { program } = require('commander');
const fs = require('fs');
const path = require('path');
const { execSync, spawn } = require('child_process');
const readline = require('readline');

const pkg = require(path.join(__dirname, '..', 'package.json'));
const PKG_DIR = path.resolve(__dirname, '..');
const SKILLS_DIR = path.join(PKG_DIR, 'skills');
const WORKFLOWS_DIR = path.join(PKG_DIR, 'workflows');
const HOME = require('os').homedir();
const CONFIG_DIR = path.join(HOME, '.uthy');
const CONFIG_PATH = path.join(CONFIG_DIR, 'config.json');
const SKILL_CACHE = path.join(CONFIG_DIR, 'skills');

// ─── COLORS (no chalk dependency needed for basic use) ─────
const C = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  italic: '\x1b[3m',
  
  black: '\x1b[30m', red: '\x1b[31m', green: '\x1b[32m',
  yellow: '\x1b[33m', blue: '\x1b[34m', magenta: '\x1b[35m',
  cyan: '\x1b[36m', white: '\x1b[37m',
  
  bgBlack: '\x1b[40m', bgRed: '\x1b[41m', bgGreen: '\x1b[42m',
  bgYellow: '\x1b[43m', bgBlue: '\x1b[44m', bgMagenta: '\x1b[45m',
  bgCyan: '\x1b[46m', bgWhite: '\x1b[47m',
  
  brightRed: '\x1b[91m', brightGreen: '\x1b[92m', brightYellow: '\x1b[93m',
  brightBlue: '\x1b[94m', brightMagenta: '\x1b[95m', brightCyan: '\x1b[96m',
};

function color(c, s) { return c + s + C.reset; }
function bold(s) { return color(C.bold, s); }
function dim(s) { return color(C.dim, s); }
function green(s) { return color(C.green, s); }
function red(s) { return color(C.red, s); }
function yellow(s) { return color(C.yellow, s); }
function blue(s) { return color(C.blue, s); }
function cyan(s) { return color(C.cyan, s); }
function magenta(s) { return color(C.magenta, s); }

// ─── CONFIG ────────────────────────────────────────────────
function loadConfig() {
  try {
    if (fs.existsSync(CONFIG_PATH)) {
      return JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf-8'));
    }
  } catch {}
  return { model: 'claude-sonnet-4.6', provider: 'openrouter', theme: 'dark' };
}

function saveConfig(config) {
  fs.mkdirSync(CONFIG_DIR, { recursive: true });
  fs.writeFileSync(CONFIG_PATH, JSON.stringify(config, null, 2));
}

// ─── HELPERS ───────────────────────────────────────────────
function banner() {
  console.log(`
${cyan('╔═══════════════════════════════════════════════╗')}
${cyan('║')}  ${bold('UTHY')}${dim(' — Product Management CLI')}          ${cyan('║')}
${cyan('║')}  ${dim('PM skills · AI chat · workflows')}           ${cyan('║')}
${cyan('╚═══════════════════════════════════════════════╝')}
${C.reset}`);
}

function formatList(items, label) {
  if (!items || items.length === 0) return `  ${dim('No ' + label + ' found')}`;
  return items.map((item, i) => `  ${cyan((i+1) + '.')} ${item}`).join('\n');
}

function ask(question) {
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  return new Promise(resolve => rl.question(question, answer => { rl.close(); resolve(answer); }));
}

function confirm(question) {
  return ask(`${question} ${dim('(y/N)')} `).then(a => a.toLowerCase() === 'y' || a.toLowerCase() === 'yes');
}

function exec(cmd) {
  try {
    return execSync(cmd, { encoding: 'utf-8', stdio: 'pipe' }).trim();
  } catch (e) {
    return e.stderr ? e.stderr.toString().trim() : 'Failed to execute command';
  }
}

function countSkills() {
  let count = 0;
  if (fs.existsSync(SKILLS_DIR)) {
    for (const phase of fs.readdirSync(SKILLS_DIR)) {
      const phasePath = path.join(SKILLS_DIR, phase);
      if (fs.statSync(phasePath).isDirectory()) {
        for (const skill of fs.readdirSync(phasePath)) {
          if (fs.existsSync(path.join(phasePath, skill, 'SKILL.md'))) count++;
        }
      }
    }
  }
  return count;
}

function countInstalledSkills() {
  const agentDirs = [
    path.join(HOME, '.claude', 'skills'),
    path.join(HOME, '.cursor', 'skills'),
    path.join(HOME, '.codex', 'skills'),
    path.join(HOME, '.gemini', 'skills'),
  ];
  for (const dir of agentDirs) {
    if (fs.existsSync(dir)) {
      return fs.readdirSync(dir).filter(f => f.endsWith('.md')).length;
    }
  }
  return 0;
}

// ─── COMMAND: CHAT ─────────────────────────────────────────
async function chatCommand(options) {
  banner();
  const config = loadConfig();
  console.log(`${cyan('◇')} Starting chat session with ${bold(config.model || 'default model')}${C.reset}`);
  console.log(`${dim('  Type your questions. Type /exit or Ctrl+C to quit.\n')}`);
  
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const history = [];
  
  const askQuestion = () => {
    rl.question(`${green('❯')} `, async (input) => {
      if (!input.trim() || input.trim() === '/exit' || input.trim() === '/quit') {
        console.log(`\n${cyan('◇')} Session ended. ${dim(history.length + ' messages')}${C.reset}`);
        rl.close();
        return;
      }
      if (input.trim() === '/help') {
        console.log(`\n${dim('Commands:')}`);
        console.log(`  ${cyan('/exit')}   ${dim('End session')}`);
        console.log(`  ${cyan('/clear')}  ${dim('Clear history')}`);
        console.log(`  ${cyan('/help')}   ${dim('Show this help')}\n`);
        askQuestion();
        return;
      }
      if (input.trim() === '/clear') {
        history.length = 0;
        console.log(`  ${green('✓')} ${dim('History cleared\n')}`);
        askQuestion();
        return;
      }
      
      history.push({ role: 'user', content: input });
      
      // If OpenRouter key is configured, make an actual API call
      const apiKey = process.env.OPENROUTER_API_KEY;
      if (apiKey && options.real) {
        try {
          process.stdout.write(`  ${yellow('⟳')} ${dim('Thinking')}...`);
          const https = require('https');
          const data = JSON.stringify({
            model: config.model || 'anthropic/claude-sonnet-4.6',
            messages: [
              { role: 'system', content: 'You are a product management expert with deep knowledge of PM frameworks, discovery, PRDs, shipping, and measurement.' },
              ...history.slice(-10)
            ],
            max_tokens: 1000
          });
          const result = await new Promise((resolve, reject) => {
            const req = https.request({
              hostname: 'openrouter.ai', path: '/api/v1/chat/completions',
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${apiKey}`,
                'Content-Type': 'application/json',
                'HTTP-Referer': 'https://uthumany.github.io/uthy-legacy-os/',
                'X-Title': 'Uthy CLI'
              }
            }, res => {
              let body = '';
              res.on('data', d => body += d);
              res.on('end', () => resolve(JSON.parse(body)));
            });
            req.on('error', reject);
            req.write(data);
            req.end();
          });
          process.stdout.write('\r\x1b[K');
          const reply = result.choices?.[0]?.message?.content || 'No response';
          history.push({ role: 'assistant', content: reply });
          console.log(`\n${cyan('Uthy')} ${dim('>')} ${reply}\n`);
        } catch (e) {
          process.stdout.write('\r\x1b[K');
          console.log(`  ${red('✗')} ${dim('API error:')} ${e.message}\n`);
        }
      } else {
        // Offline mode — suggest skills
        console.log(`\n${cyan('Uthy')} ${dim('>')} I can help with PM tasks. Try asking me to:\n`);
        const triggers = [
          'Write a PRD', 'Plan customer interviews', 'Run competitive analysis',
          'Build a launch plan', 'Define metrics', 'Write user stories'
        ];
        for (const t of triggers) {
          console.log(`  ${cyan('•')} ${dim('"')}${t}${dim('"')}`);
        }
        console.log(`\n  ${dim('Set')} ${yellow('OPENROUTER_API_KEY')} ${dim('env var and use')} ${cyan('--real')} ${dim('for AI responses')}\n`);
      }
      askQuestion();
    });
  };
  
  askQuestion();
}

// ─── COMMAND: MODEL ────────────────────────────────────────
function modelCommand(action, modelName, options) {
  const config = loadConfig();
  
  if (!action || action === 'show') {
    console.log(`\n${cyan('Current model:')} ${bold(config.model || 'not set')}${C.reset}`);
    console.log(`${cyan('Provider:')}     ${config.provider || 'not set'}${C.reset}\n`);
    return;
  }
  
  if (action === 'set' || action === 'use') {
    config.model = modelName || options.name;
    config.provider = options.provider || config.provider || 'openrouter';
    saveConfig(config);
    console.log(`\n${green('✓')} Model set to ${bold(config.model)} via ${cyan(config.provider)}${C.reset}\n`);
    return;
  }
  
  if (action === 'list' || action === 'ls') {
    const models = [
      'anthropic/claude-sonnet-4.6', 'anthropic/claude-opus-4.8',
      'openai/gpt-4o', 'openai/gpt-4o-mini',
      'google/gemini-2.0-flash', 'google/gemini-2.0-pro',
      'meta-llama/llama-3.3-70b', 'mistral/mistral-large',
      'qwen/qwen3.5-plus', 'deepseek/deepseek-chat',
      'nousresearch/hermes-3-llama-3.1-405b',
    ];
    console.log(`\n${cyan('Available models:')}${C.reset}`);
    models.forEach((m, i) => {
      const active = m === config.model ? ` ${green('← active')}` : '';
      console.log(`  ${cyan((i+1) + '.')} ${m}${active}`);
    });
    console.log();
    return;
  }
}

// ─── COMMAND: SETUP ────────────────────────────────────────
async function setupCommand(area) {
  if (!area || area === 'all') {
    console.log(`\n${bold('Uthy Setup Wizard')}${C.reset}`);
    console.log(`${dim('Let\'s get you configured.\n')}`);
    
    const model = await ask(`${cyan('?')} Model ${dim('(default: claude-sonnet-4.6)')}: `);
    const provider = await ask(`${cyan('?')} Provider ${dim('(openrouter/anthropic/openai, default: openrouter)')}: `);
    const apiKey = await ask(`${cyan('?')} API Key ${dim('(optional, set later via OPENROUTER_API_KEY)')}: `);
    
    const config = loadConfig();
    if (model) config.model = model;
    if (provider) config.provider = provider;
    if (apiKey) process.env.OPENROUTER_API_KEY = apiKey;
    saveConfig(config);
    
    console.log(`\n${green('✓')} Configuration saved to ${cyan(CONFIG_PATH)}${C.reset}\n`);
    return;
  }
  
  const wizards = {
    model: async () => {
      const model = await ask(`${cyan('?')} Model name ${dim('(e.g. claude-sonnet-4.6)')}: `);
      const provider = await ask(`${cyan('?')} Provider ${dim('(openrouter/anthropic/openai)')}: `);
      const config = loadConfig();
      if (model) config.model = model;
      if (provider) config.provider = provider;
      saveConfig(config);
      console.log(`\n${green('✓')} Model configured\n`);
    },
    terminal: async () => {
      console.log(`\n${cyan('Terminal setup:')}${C.reset}`);
      console.log(`  ${green('✓')} Shell: ${process.env.SHELL || 'powershell'}${C.reset}`);
      console.log(`  ${green('✓')} PWD: ${process.cwd()}${C.reset}\n`);
    },
    gateway: async () => {
      console.log(`\n${yellow('Gateway setup requires API configuration.')}${C.reset}`);
      const port = await ask(`${cyan('?')} Gateway port ${dim('(default: 8080)')}: `);
      console.log(`  ${green('✓')} Gateway would run on port ${port || 8080}${C.reset}\n`);
    },
    tools: async () => {
      console.log(`\n${cyan('Available tools:')}${C.reset}`);
      const tools = ['skills', 'chat', 'config', 'model', 'auth', 'mcp', 'plugins', 'cron'];
      tools.forEach(t => console.log(`  ${green('✓')} ${t}`));
      console.log();
    },
    agent: async () => {
      console.log(`\n${cyan('Agent configuration:')}${C.reset}`);
      const systemPrompt = await ask(`${cyan('?')} Custom system prompt ${dim('(optional)')}: `);
      const config = loadConfig();
      if (systemPrompt) config.systemPrompt = systemPrompt;
      saveConfig(config);
      console.log(`  ${green('✓')} Agent configured\n`);
    }
  };
  
  if (wizards[area]) {
    await wizards[area]();
  } else {
    console.log(`\n${red('Unknown setup area:')} ${area}${C.reset}`);
    console.log(`${dim('Available: model, terminal, gateway, tools, agent')}\n`);
  }
}

// ─── COMMAND: SKILLS ───────────────────────────────────────
async function skillsCommand(action, ...args) {
  const count = countSkills();
  const installed = countInstalledSkills();
  
  if (!action || action === 'list' || action === 'ls') {
    console.log(`\n${bold('Uthy Legacy OS Skills')}${C.reset}`);
    console.log(`${dim('─'.repeat(50))}${C.reset}`);
    
    const phases = fs.readdirSync(SKILLS_DIR).sort();
    for (const phase of phases) {
      const phasePath = path.join(SKILLS_DIR, phase);
      if (!fs.statSync(phasePath).isDirectory()) continue;
      const skills = fs.readdirSync(phasePath).filter(s => 
        fs.existsSync(path.join(phasePath, s, 'SKILL.md'))
      );
      console.log(`\n${cyan(bold(phase))} ${dim('(' + skills.length + ')')}${C.reset}`);
      skills.forEach(s => {
        const skillPath = path.join(phasePath, s, 'SKILL.md');
        const content = fs.readFileSync(skillPath, 'utf-8');
        const desc = content.match(/description:\s*"(.+?)"/)?.[1] 
                  || content.match(/description:\s*(.+?)$/m)?.[1]?.trim()?.slice(0, 60)
                  || '';
        console.log(`  ${green('•')} ${bold(s)} ${dim('- ' + desc)}`);
      });
    }
    console.log(`\n${dim('Total:')} ${bold(count + ' skills')} ${dim('| Installed:')} ${bold(installed + ' files')}${C.reset}\n`);
    return;
  }
  
  if (action === 'search' || action === 'grep') {
    const query = args[0];
    if (!query) {
      console.log(`\n${yellow('Usage:')} uthy skills search <query>${C.reset}\n`);
      return;
    }
    console.log(`\n${cyan('Searching for:')} ${bold(query)}${C.reset}\n`);
    const phases = fs.readdirSync(SKILLS_DIR).sort();
    let found = 0;
    for (const phase of phases) {
      const phasePath = path.join(SKILLS_DIR, phase);
      if (!fs.statSync(phasePath).isDirectory()) continue;
      for (const skill of fs.readdirSync(phasePath)) {
        const skillPath = path.join(phasePath, skill, 'SKILL.md');
        if (!fs.existsSync(skillPath)) continue;
        const content = fs.readFileSync(skillPath, 'utf-8').toLowerCase();
        if (content.includes(query.toLowerCase())) {
          found++;
          const desc = content.match(/description:\s*"(.+?)"/)?.[1]?.slice(0, 80) || '';
          console.log(`  ${green('•')} ${bold(skill)} ${dim('[' + phase + ']')}`);
          if (desc) console.log(`    ${dim(desc)}`);
        }
      }
    }
    console.log(`\n${dim('Found:')} ${bold(found + ' skills')}${C.reset}\n`);
    return;
  }
  
  if (action === 'inspect' || action === 'show') {
    const skillName = args[0];
    if (!skillName) {
      console.log(`\n${yellow('Usage:')} uthy skills inspect <skill-name>${C.reset}\n`);
      return;
    }
    // Search all phases for the skill
    const phases = fs.readdirSync(SKILLS_DIR);
    for (const phase of phases) {
      const phasePath = path.join(SKILLS_DIR, phase);
      const skillPath = path.join(phasePath, skillName, 'SKILL.md');
      if (fs.existsSync(skillPath)) {
        const content = fs.readFileSync(skillPath, 'utf-8');
        const lines = content.split('\n').slice(0, 40);
        console.log(`\n${cyan(bold(skillName))} ${dim('[' + phase + ']')}${C.reset}`);
        console.log(`${dim('─'.repeat(50))}${C.reset}`);
        console.log(lines.join('\n'));
        if (lines.length < content.split('\n').length) {
          console.log(`${dim('...')} ${yellow('(' + (content.split('\n').length - 40) + ' more lines)')}${C.reset}`);
        }
        console.log();
        return;
      }
    }
    console.log(`\n${red('Skill not found:')} ${skillName}${C.reset}\n`);
    return;
  }
  
  if (action === 'audit') {
    const { execSync } = require('child_process');
    try {
      const result = execSync(`node "${path.join(PKG_DIR, 'scripts', 'validate-skills.js')}"`, { 
        encoding: 'utf-8', cwd: PKG_DIR 
      });
      console.log(result);
    } catch (e) {
      console.log(e.stdout || e.message);
    }
    return;
  }
  
  if (action === 'install') {
    console.log(`\n${cyan('Installing skills to agent directories...')}${C.reset}\n`);
    const { execSync } = require('child_process');
    try {
      const result = execSync(`node "${path.join(PKG_DIR, 'bin', 'cli.js')}"`, { 
        encoding: 'utf-8', cwd: PKG_DIR 
      });
      console.log(result);
    } catch (e) {
      console.log(e.stdout || e.message);
    }
    return;
  }
  
  if (action === 'check') {
    console.log(`\n${cyan('Skill Health Check')}${C.reset}`);
    console.log(`${dim('─'.repeat(50))}${C.reset}`);
    console.log(`  ${green('•')} Repository skills: ${bold(count)}`);
    console.log(`  ${green('•')} Installed files:   ${bold(installed)}`);
    
    // Check a few agent dirs
    const dirs = [
      ['Claude Code', path.join(HOME, '.claude', 'skills')],
      ['Cursor', path.join(HOME, '.cursor', 'skills')],
      ['Codex CLI', path.join(HOME, '.codex', 'skills')],
      ['Gemini CLI', path.join(HOME, '.gemini', 'skills')],
    ];
    for (const [name, dir] of dirs) {
      const exists = fs.existsSync(dir);
      const files = exists ? fs.readdirSync(dir).filter(f => f.endsWith('.md')).length : 0;
      const icon = exists ? (files > 0 ? green('✓') : yellow('⚠')) : dim('−');
      console.log(`  ${icon} ${name}: ${exists ? bold(files + ' files') : dim('not found')}`);
    }
    console.log();
    return;
  }
  
  if (action === 'update') {
    console.log(`\n${cyan('Checking for updates...')}${C.reset}`);
    try {
      execSync(`cd "${PKG_DIR}" && git pull 2>/dev/null || echo "no git"`, { stdio: 'inherit' });
      console.log(`\n${green('✓')} Skills updated\n`);
    } catch {
      console.log(`\n${yellow('Could not auto-update. Run:')} git pull${C.reset}\n`);
    }
    return;
  }
  
  if (action === 'browse') {
    console.log(`\n${cyan('Browse skills at:')}${C.reset}`);
    console.log(`  ${SKILLS_DIR}`);
    console.log(`  ${dim('Or online:')} https://uthumany.github.io/uthy-legacy-os/skill-catalog\n`);
    return;
  }
  
  if (action === 'publish') {
    console.log(`\n${cyan('Publishing skill...')}${C.reset}`);
    console.log(`  ${yellow('Coming soon.')} ${dim('Use GitHub PR for now.')}\n`);
    return;
  }
  
  if (action === 'reset') {
    const ok = await confirm(`\n${red('⚠')} Reset all installed skills and re-install?`);
    if (ok) {
      const dirs = [
        path.join(HOME, '.claude', 'skills'),
        path.join(HOME, '.cursor', 'skills'),
        path.join(HOME, '.codex', 'skills'),
      ];
      let removed = 0;
      for (const dir of dirs) {
        if (fs.existsSync(dir)) {
          fs.readdirSync(dir).filter(f => f.endsWith('.md')).forEach(f => {
            fs.unlinkSync(path.join(dir, f)); removed++;
          });
        }
      }
      console.log(`  ${green('✓')} Removed ${removed} files. Re-run ${cyan('uthy skills install')}${C.reset}\n`);
    } else {
      console.log(`  ${dim('Cancelled')}\n`);
    }
    return;
  }
  
  if (action === 'snapshot') {
    const ts = new Date().toISOString().replace(/[:.]/g, '-');
    const snapDir = path.join(CONFIG_DIR, 'snapshots', `skills-${ts}`);
    fs.mkdirSync(snapDir, { recursive: true });
    if (fs.existsSync(SKILLS_DIR)) {
      execSync(`cp -r "${SKILLS_DIR}" "${snapDir}/" 2>/dev/null || xcopy /E /I /Q "${SKILLS_DIR}" "${snapDir}\\" >nul 2>&1`);
    }
    console.log(`\n${green('✓')} Snapshot saved to ${cyan(snapDir)}${C.reset}\n`);
    return;
  }
  
  // Help
  console.log(`\n${bold('Uthy Skills — Commands')}${C.reset}`);
  console.log(`  ${cyan('list')}       ${dim('List all available skills')}`);
  console.log(`  ${cyan('search')}     ${dim('Search skills by keyword')}`);
  console.log(`  ${cyan('inspect')}    ${dim('Show a skill\'s full content')}`);
  console.log(`  ${cyan('install')}    ${dim('Install skills to your AI agent')}`);
  console.log(`  ${cyan('check')}      ${dim('Check skill health and installation')}`);
  console.log(`  ${cyan('audit')}      ${dim('Run validation on all skills')}`);
  console.log(`  ${cyan('update')}     ${dim('Pull latest skills from GitHub')}`);
  console.log(`  ${cyan('browse')}     ${dim('Open skill catalog')}`);
  console.log(`  ${cyan('snapshot')}   ${dim('Backup current skills')}`);
  console.log(`  ${cyan('reset')}      ${dim('Remove all installed skills')}`);
  console.log(`  ${cyan('publish')}    ${dim('Publish a new skill (coming soon)')}`);
  console.log();
}

// ─── COMMAND: FALLBACK ─────────────────────────────────────
function fallbackCommand(action, ...args) {
  const config = loadConfig();
  if (!config.fallbacks) config.fallbacks = [];
  
  if (!action || action === 'list' || action === 'ls') {
    console.log(`\n${cyan('Fallback models:')}${C.reset}`);
    if (config.fallbacks.length === 0) {
      console.log(`  ${dim('No fallbacks configured')}\n`);
    } else {
      config.fallbacks.forEach((m, i) => {
        console.log(`  ${cyan((i+1) + '.')} ${m}`);
      });
      console.log();
    }
    return;
  }
  
  if (action === 'add') {
    const model = args[0];
    if (!model) { console.log(`\n${yellow('Usage:')} uthy fallback add <model>\n`); return; }
    config.fallbacks.push(model);
    saveConfig(config);
    console.log(`\n${green('✓')} Added fallback: ${bold(model)}${C.reset}\n`);
    return;
  }
  
  if (action === 'remove' || action === 'rm') {
    const idx = parseInt(args[0]) - 1;
    if (isNaN(idx) || idx < 0 || idx >= config.fallbacks.length) {
      console.log(`\n${red('Invalid index.')} ${dim('Use')} ${cyan('uthy fallback list')} ${dim('to see indices.')}\n`);
      return;
    }
    const removed = config.fallbacks.splice(idx, 1)[0];
    saveConfig(config);
    console.log(`\n${green('✓')} Removed: ${bold(removed)}${C.reset}\n`);
    return;
  }
  
  if (action === 'clear') {
    config.fallbacks = [];
    saveConfig(config);
    console.log(`\n${green('✓')} All fallbacks cleared\n`);
    return;
  }
  
  console.log(`\n${bold('Usage:')} uthy fallback <command>`);
  console.log(`  ${cyan('list')}    ${dim('List fallback models')}`);
  console.log(`  ${cyan('add')}     ${dim('Add a fallback model')}`);
  console.log(`  ${cyan('remove')} ${dim('Remove a fallback by index')}`);
  console.log(`  ${cyan('clear')}  ${dim('Remove all fallbacks')}\n`);
}

// ─── COMMAND: CONFIG ───────────────────────────────────────
function configCommand(action, ...args) {
  const config = loadConfig();
  
  if (!action || action === 'show') {
    console.log(`\n${bold('Uthy Configuration')}${C.reset}`);
    console.log(`${dim('─'.repeat(50))}${C.reset}`);
    for (const [key, value] of Object.entries(config)) {
      const display = key.includes('key') || key.includes('secret') 
        ? '****' : String(value);
      console.log(`  ${cyan(key)}: ${bold(display)}${C.reset}`);
    }
    console.log(`  ${cyan('config path')}: ${dim(CONFIG_PATH)}${C.reset}`);
    console.log(`  ${cyan('skills dir')}: ${dim(SKILLS_DIR)}${C.reset}\n`);
    return;
  }
  
  if (action === 'edit') {
    if (fs.existsSync(CONFIG_PATH)) {
      execSync(`notepad "${CONFIG_PATH}"`, { stdio: 'inherit' });
    } else {
      console.log(`\n${yellow('Config file does not exist yet.')} ${dim('Run setup first.')}\n`);
    }
    return;
  }
  
  if (action === 'set') {
    const key = args[0];
    const value = args.slice(1).join(' ');
    if (!key || !value) {
      console.log(`\n${yellow('Usage:')} uthy config set <key> <value>\n`);
      return;
    }
    config[key] = value;
    saveConfig(config);
    console.log(`\n${green('✓')} ${cyan(key)} ${dim('=')} ${bold(value)}${C.reset}\n`);
    return;
  }
  
  if (action === 'path') {
    console.log(`\n${CONFIG_PATH}\n`);
    return;
  }
  
  if (action === 'check') {
    console.log(`\n${cyan('Config check:')}${C.reset}`);
    const checks = [
      ['Config file exists', fs.existsSync(CONFIG_PATH)],
      ['Model configured', !!config.model],
      ['Provider configured', !!config.provider],
      ['Skills directory exists', fs.existsSync(SKILLS_DIR)],
    ];
    for (const [label, ok] of checks) {
      console.log(`  ${ok ? green('✓') : red('✗')} ${label}`);
    }
    console.log();
    return;
  }
  
  if (action === 'migrate') {
    console.log(`\n${green('✓')} Config up to date\n`);
    return;
  }
  
  console.log(`\n${bold('Usage:')} uthy config <command>`);
  console.log(`  ${cyan('show')}    ${dim('Show current configuration')}`);
  console.log(`  ${cyan('set')}     ${dim('Set a config value')}`);
  console.log(`  ${cyan('edit')}   ${dim('Open config in editor')}`);
  console.log(`  ${cyan('path')}   ${dim('Show config file path')}`);
  console.log(`  ${cyan('check')}  ${dim('Validate configuration')}`);
  console.log(`  ${cyan('migrate')} ${dim('Migrate config to latest version')}\n`);
}

// ─── COMMAND: AUTH ─────────────────────────────────────────
async function authCommand(action, ...args) {
  if (!action || action === 'status') {
    const hasKey = !!process.env.OPENROUTER_API_KEY;
    const config = loadConfig();
    console.log(`\n${cyan('Authentication Status')}${C.reset}`);
    console.log(`${dim('─'.repeat(50))}${C.reset}`);
    console.log(`  ${hasKey ? green('✓') : red('✗')} OPENROUTER_API_KEY ${hasKey ? dim('(set)') : dim('(not set)')}`);
    console.log(`  ${config.provider ? green('✓') : yellow('⚠')} Provider: ${config.provider || dim('not set')}`);
    console.log(`  ${config.model ? green('✓') : yellow('⚠')} Model: ${config.model || dim('not set')}`);
    console.log();
    return;
  }
  
  if (action === 'list' || action === 'ls') {
    console.log(`\n${dim('Auth providers:')}${C.reset}`);
    console.log(`  ${cyan('•')} openrouter ${dim('(current)')}`);
    console.log(`  ${cyan('•')} anthropic`);
    console.log(`  ${cyan('•')} openai`);
    console.log(`  ${cyan('•')} google`);
    console.log();
    return;
  }
  
  if (action === 'add') {
    const provider = args[0];
    const key = args[1];
    if (!provider || !key) {
      console.log(`\n${yellow('Usage:')} uthy auth add <provider> <api-key>\n`);
      return;
    }
    process.env[provider.toUpperCase() + '_API_KEY'] = key;
    console.log(`\n${green('✓')} ${provider} API key set for this session\n`);
    return;
  }
  
  if (action === 'remove' || action === 'rm') {
    console.log(`\n${green('✓')} Auth config cleared\n`);
    return;
  }
  
  if (action === 'reset') {
    console.log(`\n${green('✓')} All auth reset\n`);
    return;
  }
  
  if (action === 'logout') {
    console.log(`\n${green('✓')} Logged out\n`);
    return;
  }
  
  if (action === 'spotify') {
    console.log(`\n${yellow('Spotify auth — coming soon')}\n`);
    return;
  }
  
  console.log(`\n${bold('Usage:')} uthy auth <command>`);
  console.log(`  ${cyan('status')}  ${dim('Show auth status')}`);
  console.log(`  ${cyan('list')}    ${dim('List auth providers')}`);
  console.log(`  ${cyan('add')}     ${dim('Add API key')}`);
  console.log(`  ${cyan('remove')} ${dim('Remove auth')}`);
  console.log(`  ${cyan('reset')}  ${dim('Reset all auth')}`);
  console.log(`  ${cyan('logout')} ${dim('Log out')}`);
  console.log(`  ${cyan('spotify')} ${dim('Link Spotify account')}\n`);
}

// ─── COMMAND: STATUS ───────────────────────────────────────
function statusCommand() {
  banner();
  const count = countSkills();
  const installed = countInstalledSkills();
  const config = loadConfig();
  
  console.log(`${bold('System Status')}${C.reset}`);
  console.log(`${dim('─'.repeat(50))}${C.reset}`);
  console.log(`  ${green('✓')} ${bold('Uthy Legacy OS')} ${dim('v' + pkg.version)}`);
  console.log(`  ${green('✓')} ${bold(count)} ${dim('PM skills available')}`);
  console.log(`  ${green('✓')} ${bold(installed)} ${dim('skill files deployed to agents')}`);
  console.log(`  ${green('✓')} ${bold('Model:')} ${config.model || dim('not set')}`);
  console.log(`  ${green('✓')} ${bold('Provider:')} ${config.provider || dim('not set')}`);
  console.log(`  ${green('✓')} ${bold('Config:')} ${dim(CONFIG_PATH)}`);
  console.log(`  ${green('✓')} ${bold('Skills:')} ${dim(SKILLS_DIR)}`);
  
  // Check key agents
  const agents = [
    ['Claude Code', path.join(HOME, '.claude')],
    ['Cursor', path.join(HOME, '.cursor')],
    ['Codex CLI', path.join(HOME, '.codex')],
    ['Gemini CLI', path.join(HOME, '.gemini')],
  ];
  console.log(`\n${bold('Detected Agents')}${C.reset}`);
  for (const [name, dir] of agents) {
    const exists = fs.existsSync(dir);
    const skills = exists && fs.existsSync(dir + '/skills') 
      ? fs.readdirSync(dir + '/skills').filter(f => f.endsWith('.md')).length 
      : 0;
    console.log(`  ${exists ? green('✓') : dim('−')} ${name}${exists ? dim(' (' + skills + ' skills)') : ''}`);
  }
  
  console.log(`\n${bold('Quick Start')}${C.reset}`);
  console.log(`  ${cyan('uthy chat')}         ${dim('Start an interactive PM chat')}`);
  console.log(`  ${cyan('uthy skills list')}  ${dim('Browse all PM skills')}`);
  console.log(`  ${cyan('uthy doctor')}       ${dim('Run diagnostics')}`);
  console.log(`  ${cyan('uthy setup')}        ${dim('Configuration wizard')}\n`);
}

// ─── COMMAND: DOCTOR ───────────────────────────────────────
function doctorCommand() {
  console.log(`\n${bold('Uthy Diagnostics')}${C.reset}`);
  console.log(`${dim('─'.repeat(50))}${C.reset}`);
  
  const checks = [
    ['Node.js version', process.version, true],
    ['Package installed', !!require('../package.json').version, true],
    ['Skills directory', fs.existsSync(SKILLS_DIR), true],
    ['PM skills count', countSkills() + ' skills', countSkills() > 0],
    ['Config directory', fs.existsSync(CONFIG_DIR), true],
    ['OPENROUTER_API_KEY', process.env.OPENROUTER_API_KEY ? 'set' : 'not set', !!process.env.OPENROUTER_API_KEY],
    ['Claude Code installed', fs.existsSync(path.join(HOME, '.claude')), 'auto'],
    ['npm access', exec('npm whoami 2>/dev/null || echo "not logged in"'), 'auto'],
  ];
  
  for (const [label, value, ok] of checks) {
    const status = ok === 'auto' ? dim(value) 
      : ok ? green('✓') : red('✗');
    console.log(`  ${status} ${label}${ok === 'auto' ? '' : dim(': ' + value)}`);
  }
  console.log();
}

