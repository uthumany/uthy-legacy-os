// ─── CRON ──────────────────────────────────────────────────
function cronCommand(action, ...args) {
  const jobsFile = path.join(CONFIG_DIR, 'cron.json');
  let jobs = [];
  try { jobs = JSON.parse(fs.readFileSync(jobsFile, 'utf-8')); } catch {}
  
  const actions = {
    list: () => {
      console.log(`\n${cyan('Cron Jobs:')}${C.reset}`);
      if (jobs.length === 0) console.log(`  ${dim('No jobs configured')}`);
      else jobs.forEach((j, i) => console.log(`  ${cyan(i+1)} ${j.schedule} ${dim('-')} ${j.name || j.prompt?.slice(0,40)}`));
      console.log();
    },
    status: () => console.log(`\n${jobs.length > 0 ? green('✓ Active') : yellow('No jobs')} ${dim('(' + jobs.length + ' jobs configured)')}\n`),
    clear: () => { fs.writeFileSync(jobsFile, '[]'); console.log(`\n${green('✓')} All cron jobs cleared\n`); },
  };
  if (actions[action]) actions[action]();
  else console.log(`\n${bold('Usage:')} uthy cron {list|create|edit|pause|resume|run|remove|status|tick}\n`);
}

